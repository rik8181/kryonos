// ============================================================
// KryonOS Plymouth boot splash script
// ============================================================
// Elvárt fájlok ugyanebben a mappában:
//   - logo.png       (a KryonOS logó, átlátszó háttérrel, kb. 300x300 px)
//   - progress-*.png (opcionális, animált töltés-sprite-sorozat, pl.
//                      progress-1.png .. progress-24.png)
//
// Ha nincs egyedi logó, a lenti "szöveges fallback" blokk helyette
// egyszerű renderelt szöveget rajzol ki a rendszer nevével.
// ============================================================

Window.SetBackgroundTopColor(0.05, 0.06, 0.09);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.04);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

// --- Logó középre igazítva ---
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_width  / 2 - logo.image.GetWidth()  / 2;
logo.y = screen_height / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10000);

// --- Rendszernév felirat a logó alatt ---
// A Plymouth script motor natívan nem rendereli a szabad szöveget,
// ezért ez egy előre generált PNG ("wordmark.png") mint sprite —
// generáld pl. Inkscape-ben/Figma-ban a végleges betűtípussal.
wordmark.image = Image("wordmark.png");
wordmark.sprite = Sprite(wordmark.image);
wordmark.x = screen_width / 2 - wordmark.image.GetWidth() / 2;
wordmark.y = logo.y + logo.image.GetHeight() + 20;
wordmark.sprite.SetPosition(wordmark.x, wordmark.y, 10000);

// --- Töltés-animáció (finom, pontokból álló spinner) ---
progress_dots = 24;
for (i = 1; i <= progress_dots; i++) {
    progress_image[i] = Image("progress-" + i + ".png");
}

progress_sprite = Sprite();
progress_sprite.SetPosition(
    screen_width / 2 - 32,
    wordmark.y + wordmark.image.GetHeight() + 50,
    10000
);

fun refresh_callback() {
    frame = (Plymouth.GetBootProgress() * (progress_dots - 1));
    frame = Math.Int(frame) + 1;
    if (frame > progress_dots) frame = progress_dots;
    progress_sprite.SetImage(progress_image[frame]);
}
Plymouth.SetRefreshFunction(refresh_callback);

// --- Üzenetek (pl. LUKS jelszókérés, hibaüzenetek) ---
fun display_message_callback(text) {
    message.image = Image.Text(text, 1, 1, 1);
    message.sprite = Sprite(message.image);
    message.sprite.SetPosition(
        screen_width  / 2 - message.image.GetWidth() / 2,
        screen_height - 80,
        10001
    );
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
