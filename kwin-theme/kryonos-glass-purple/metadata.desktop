[Desktop Entry]
Name=KryonOS Glass — Purple Nebula
Comment=macOS-ihletésű frosted-glass ablakdekoráció, bal oldali traffic-light gombokkal (Purple Nebula akcentszín)
Type=Service
X-KDE-ServiceTypes=KWin/Decoration
X-KDE-Library=kwin3_aurorae
X-KDE-PluginInfo-Name=kryonos-glass-purple
X-KDE-PluginInfo-Author=KryonOS Project
X-KDE-PluginInfo-Version=1.0

[KWin Aurorae Config]
BorderLeft=1
BorderRight=1
BorderBottom=1
BorderTop=32
BorderTopTitleEdge=0

; A gombok mérete/térköze — a "buttons.svg"-ben definiált traffic-light
; köröknek megfelelően finomhangolva
ButtonWidth=14
ButtonHeight=14
ButtonSpacing=8
ButtonMarginLeft=13
